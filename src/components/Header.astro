---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { slugify } from "@/utils/utils";

import Profile from "@/assets/45540656.jpeg";

const posts = await getCollection("posts");

const tags = [
  ...new Set(
    posts.flatMap((post) => (post.data.tags ?? []).map((tag) => slugify(tag))),
  ),
];
---

<header
  class="flex flex-col items-start justify-between gap-6 border-b border-gray-200 pb-6 lg:flex-row lg:items-center dark:border-gray-800"
>
  <a href="/" class="flex items-center gap-3">
    <Image src={Profile} alt="Profile picture" class="size-8 rounded" />
    <h1 class="text-3xl font-bold sm:text-4xl">McLogicmaster69</h1>
  </a>

  <nav>
    <ul class="flex flex-wrap gap-3 text-sm">
      {
        tags.map((tag) => (
          <li>
            <a
              href={`/tags/${slugify(tag)}`}
              class="rounded border border-gray-300 bg-gray-200 px-2 py-1 text-gray-600 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-300"
            >
              {tag}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
