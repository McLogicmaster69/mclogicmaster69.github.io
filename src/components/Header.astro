---
import { getCollection } from "astro:content";
import { slugify } from "@/utils/utils";

const posts = await getCollection("posts");

const tags = [
  ...new Set(
    posts.flatMap((post) => (post.data.tags ?? []).map((tag) => slugify(tag))),
  ),
];
---

<header
  class="flex flex-col items-start justify-between gap-3 lg:flex-row lg:items-center"
>
  <a href="/">
    <h1 class="text-3xl font-bold sm:text-4xl">McLogicmaster69</h1>
  </a>

  <nav>
    <ul class="flex flex-wrap gap-3 text-sm">
      {
        tags.map((tag) => (
          <li>
            <a
              href={`/tags/${slugify(tag)}`}
              class="rounded-sm bg-gray-200 px-2 py-1 dark:bg-gray-800"
            >
              {tag}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
