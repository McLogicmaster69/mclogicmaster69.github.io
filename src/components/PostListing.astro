---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { slugify } from "@/utils/utils";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
---

<li class="flex flex-col gap-3">
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-semibold">{post.data.title}</h2>
    <time
      datetime={post.data.date.toISOString()}
      class="text-gray-600 dark:text-gray-400"
    >
      {
        post.data.date.toLocaleDateString("en-GB", {
          day: "numeric",
          month: "short",
          year: "numeric",
        })
      }
    </time>
  </div>

  <p class="text-gray-600 dark:text-gray-400">
    {post.data.description}
  </p>

  <a href={`/${post.collection}/${post.id}`}>
    <Image
      src={post.data.image.url}
      alt={post.data.image.alt}
      class="aspect-video w-full rounded-md object-cover"
    />
  </a>

  <div class="flex flex-wrap gap-2">
    {
      post.data.tags?.map((tag) => (
        <a
          href={`/tags/${slugify(tag)}`}
          class="rounded border border-gray-300 bg-gray-200 px-2 py-1 text-gray-600 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-300"
        >
          {tag}
        </a>
      ))
    }
  </div>
</li>
