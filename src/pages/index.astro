---
import { SITE } from "@consts";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";

export interface Project {
  title: string;
  description: string;
  link: URL;
  image: {
    src: ImageMetadata;
    alt: string;
  };
  tags: string[];
}

import alphaImg from "@assets/pjh-1-PRCgR5vig-unsplash.jpg";
import bravoImg from "@assets/tsuyoshi-kozu-_djHci4yf6A-unsplash.jpg";
import charlieImg from "@assets/zero-take-OfsOzOIvNFc-unsplash.jpg";

const projects: Project[] = [
  {
    title: "Project Alpha",
    description: "A high-performance web app.",
    link: new URL("https://alpha.example.com"),
    image: {
      src: alphaImg,
      alt: "Screenshot of Project Alpha dashboard",
    },
    tags: ["Astro", "Tailwind"],
  },
  {
    title: "Project Bravo",
    description: "Mobile-first e-commerce site.",
    link: new URL("https://beta.example.com"),
    image: {
      src: bravoImg,
      alt: "Product listing page for Project Bravo",
    },
    tags: ["React", "Node.js"],
  },
  {
    title: "Project Charlie",
    description: "Mobile-first e-commerce site.",
    link: new URL("https://charlie.example.com"),
    image: {
      src: charlieImg,
      alt: "Checkout flow UI for Project Charlie",
    },
    tags: ["React", "Node.js"],
  },
];
---

<Layout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  <ol class="space-y-6">
    {
      projects.map((p) => (
        <li class="flex flex-col gap-3">
          <h2 class="text-2xl font-semibold">{p.title}</h2>
          <p class="text-gray-600 dark:text-gray-400">{p.description}</p>
          <a href={p.link}>
            <Image
              src={p.image.src}
              alt={p.image.alt}
              class="aspect-video w-full rounded-md object-cover"
            />
          </a>
          <div class="flex flex-wrap gap-2">
            {p.tags.map((tag) => (
              <span class="rounded-sm bg-gray-200 px-2 py-1 dark:bg-gray-800">
                {tag}
              </span>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</Layout>
